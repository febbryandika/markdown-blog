{
  "name": "markdown-blog",
  "private": true,
  "workspaces": ["frontend", "backend"],
  "scripts": {
    "dev": "bun run --concurrent dev:backend dev:frontend",
    "dev:backend": "cd backend && bun run dev",
    "dev:frontend": "cd frontend && bun run dev",
    "build": "bun run typecheck && bun run build:frontend",
    "build:frontend": "cd frontend && bun run build",
    "typecheck": "bun run typecheck:backend && bun run typecheck:frontend",
    "typecheck:backend": "cd backend && bun run typecheck",
    "typecheck:frontend": "cd frontend && bun run typecheck",
    "test": "bun run test:backend && bun run test:frontend",
    "test:backend": "cd backend && bun run test",
    "test:frontend": "cd frontend && bun run test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "typescript-eslint": "^8.60.0"
  }
}
